{
  "name": "sunrise-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the Sunrise console endpoint (layer 1: transport + five tools). Private, not for publication.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sunrise-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test:endpoint": "npm run build && node scripts/endpoint-smoke.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
